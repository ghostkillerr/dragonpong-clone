[Unit]
Description=DragonPong source clone room server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=dragonpong
Group=dragonpong
WorkingDirectory=/opt/dragonpong/clone
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m dragonpong.server --host 0.0.0.0 --port 8870
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
